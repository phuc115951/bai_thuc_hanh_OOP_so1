class phuong_tien{
	private:
		int ma_xe;
		string loai_xe;
		int gio_vao;
		int tg_do;
	public:
	    phuong_tien(){
	    	ma_xe = 0;
	    	loai_xe = " ";
	    	gio_vao = 0;
	    	tg_do = 0;
		}
		phuong_tien(int ma,string loai,int gio,int tg)
		{
			ma_xe = ma;
			loai_xe = loai;
			gio_vao = gio;
			tg_do = tg;
		}
		int lay_ma_xe() const{
			return ma_xe;
		}
		string lay_loai_xe() const{
			return loai_xe;
		}
		double tinh_phi() const{
		    double don_gia = 0;
		    double tong_gia = 0;
		    if(loai_xe == "Car"){
		    	don_gia = 6;
			}
			else if(loai_xe == "Motorcycle"){
				don_gia = 4;
			}
			else if(loai_xe == "Bicycle"){
				don_gia = 2;
			}
			for(int i=0;i<tg_do;i++){
				int gio = (gio_vao + i) % 24;
				bool giocao_diem = (gio >= 6 && gio <= 10) || (gio >= 15 && gio <= 18);
				if(i <= 2){
					if(giocao_diem){
						tong_gia += don_gia * 1.3;
					}
					else{
						tong_gia += don_gia * 0.95;
					}
				}
				else{
					tong_gia += don_gia * 0.9;
				}
			}
		}
		void hien_thi() const{
		    cout << "Ma xe: " << ma_xe << "\n"
		         << "Loai xe: " << loai_xe << "\n"
		         << "Gio vao: " << gio_vao << "h\n"
		         << "Thoi gian do xe: " << tg_do << "h\n"
		         << "Phi do xe: " << tinh_phi() << "$\n";
		}
}
class bai_xe {
private:
    int ma_bai;
    char kich_thuoc;
    phuong_tien pt1,pt2,pt3;   
    bool co1, co2, co3;

public:
    bai_xe();
    bai_xe(int ma, char kt);
    int lay_ma() const;
    bool them(phuong_tien v);
    bool xoa(int ma_xe);
    bool chua(int ma_xe) const;
    void hien_thi() const;
    bool co_loai(string loai, int& dem, double& tong) const;
    
    bai_xe::bai_xe(){
    	ma_bai = 0;
    	kich_thuoc = 'S';
    	co1 = false;
    	co2 = false;
    	co3 = false;
	}
	bai_xe::bai_xe(int ma,char kt){
		ma_bai = ma;
		kich_thuoc = kt;
		co1 = false;
    	co2 = false;
    	co3 = false;
	}
	int bai_xe::lay_ma() const{
	    return ma_bai;
	}
	bool bai_xe::them(phuong_tien v) {
    int cap = (kich_thuoc == 'S') ? 1 : (kich_thuoc == 'M') ? 2 : 3;
    if (cap >= 1 && !co1) { pt1 = v; co1 = true; return true; }
    if (cap >= 2 && !co2) { pt2 = v; co2 = true; return true; }
    if (cap >= 3 && !co3) { pt3 = v; co3 = true; return true; }
    return false;
}

bool bai_xe::xoa(int ma_xe) {
    if (co1 && pt1.lay_ma_xe() == ma_xe) {
        if (co2) {
            pt1 = pt2;
            if (co3) { pt2 = pt3; co3 = false; }
            else co2 = false;
        } else co1 = false;
        return true;
    }
    if (co2 && pt2.lay_ma_xe() == ma_xe) {
        if (co3) { pt2 = pt3; co3 = false; }
        else co2 = false;
        return true;
    }
    if (co3 && pt3.lay_ma_xe() == ma_xe) {
        co3 = false;
        return true;
    }
    return false;
}

bool bai_xe::chua(int ma_xe) const {
    if (co1 && pt1.lay_ma_xe() == ma_xe) return true;
    if (co2 && pt2.lay_ma_xe() == ma_xe) return true;
    if (co3 && pt3.lay_ma_xe() == ma_xe) return true;
    return false;
}

void bai_xe::hien_thi() const {
    int cap = (kich_thuoc == 'S') ? 1 : (kich_thuoc == 'M') ? 2 : 3;
    int so_xe = co1 + co2 + co3;
    cout << "Bai " << ma_bai << " [" << kich_thuoc << "] "
         << so_xe << "/" << cap << " xe\n";
    if (co1) pt1.hien_thi();
    if (co2) pt2.hien_thi();
    if (co3) pt3.hien_thi();
}

bool bai_xe::co_loai(string loai, int& dem, double& tong) const {
    dem = 0; tong = 0;
    if (co1 && pt1.lay_loai_xe() == loai) { ++dem; tong += pt1.tinh_phi(); }
    if (co2 && pt2.lay_loai_xe() == loai) { ++dem; tong += pt2.tinh_phi(); }
    if (co3 && pt3.lay_loai_xe() == loai) { ++dem; tong += pt3.tinh_phi(); }
    return dem > 0;
}
}
